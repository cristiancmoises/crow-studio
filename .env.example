# Para gerar senha e secret automaticamente: sh scripts/start.sh
STUDIO_PASSWORD=
SESSION_SECRET=
STUDIO_PORT=8098
BIND_ADDRESS=127.0.0.1
# HTTPS público: configure ambos e use proxy TLS.
PUBLIC_URL=
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=
# Geração local privada. Provisione os pesos com sh scripts/provision-model.sh.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://inference:11434
OLLAMA_MODEL=qwen3:1.7b
# Provedor opcional: AI_PROVIDER=qwen-code.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
AI_TIMEOUT_MS=85000
