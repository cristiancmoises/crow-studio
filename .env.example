# Para gerar senha e secret automaticamente: sh scripts/start.sh
STUDIO_PASSWORD=
SESSION_SECRET=
STUDIO_PORT=8098
BIND_ADDRESS=127.0.0.1
# HTTPS público: configure ambos e use proxy TLS.
PUBLIC_URL=
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=
